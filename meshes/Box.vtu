<?xml version="1.0"?>
<!-- A cube of 10 m, from (0, 0, 0) to (10, 10, 10): one hexahedron (cell 0)
     and its 6 faces as quads (cells 1 to 6). The face at x = 0 is on the
     boundary surface west, the face at x = 10 on the boundary surface east:
     they are the in-flow and the out-flow. The other faces are on no
     boundary surface. The hexahedron is the region box. -->
<!-- Description: A cube of 10 m, from (0, 0, 0) to (10, 10, 10), with the
     region box. The face at x = 0 is the boundary surface west, the face at
     x = 10 the boundary surface east. -->
<VTKFile type="UnstructuredGrid" version="1.0" byte_order="LittleEndian">
<UnstructuredGrid>
<Piece NumberOfPoints="8" NumberOfCells="7">
<CellData Scalars="region__box">
<DataArray type="Int32" Name="region__box" format="ascii">
1 0 0 0 0 0 0
</DataArray>
<DataArray type="Int32" Name="boundary__west" format="ascii">
0 1 0 0 0 0 0
</DataArray>
<DataArray type="Int32" Name="boundary__east" format="ascii">
0 0 1 0 0 0 0
</DataArray>
</CellData>
<Points>
<DataArray type="Float64" Name="Points" NumberOfComponents="3" format="ascii">
0 0 0
10 0 0
10 10 0
0 10 0
0 0 10
10 0 10
10 10 10
0 10 10
</DataArray>
</Points>
<Cells>
<DataArray type="Int64" Name="connectivity" format="ascii">
0 1 2 3 4 5 6 7
0 3 7 4
1 2 6 5
0 1 5 4
3 2 6 7
0 1 2 3
4 5 6 7
</DataArray>
<DataArray type="Int64" Name="offsets" format="ascii">
8 12 16 20 24 28 32
</DataArray>
<DataArray type="UInt8" Name="types" format="ascii">
12 9 9 9 9 9 9
</DataArray>
</Cells>
</Piece>
</UnstructuredGrid>
</VTKFile>
