<?xml version="1.0"?>
<!-- A cube of 10 m, from (0, 0, 0) to (10, 10, 10): one hexahedron (cell 0)
     and its 6 faces as quads (cells 1 to 6), each on its boundary surface:
     west (x = 0, cell 1), east (x = 10, cell 2), south (y = 0, cell 3),
     north (y = 10, cell 4), bottom (z = 0, cell 5) and top (z = 10, cell 6).
     west and east are first: a new shape makes them the in-flow and the
     out-flow. The hexahedron is the region box. -->
<!-- Description: A cube of 10 m, from (0, 0, 0) to (10, 10, 10), with the
     region box. Each face is a boundary surface: west (x = 0), east
     (x = 10), south (y = 0), north (y = 10), bottom (z = 0) and top
     (z = 10). -->
<VTKFile type="UnstructuredGrid" version="1.0" byte_order="LittleEndian">
<UnstructuredGrid>
<Piece NumberOfPoints="8" NumberOfCells="7">
<CellData Scalars="region__box">
<DataArray type="Int32" Name="region__box" format="ascii">
1 0 0 0 0 0 0
</DataArray>
<DataArray type="Int32" Name="boundary__west" format="ascii">
0 1 0 0 0 0 0
</DataArray>
<DataArray type="Int32" Name="boundary__east" format="ascii">
0 0 1 0 0 0 0
</DataArray>
<DataArray type="Int32" Name="boundary__south" format="ascii">
0 0 0 1 0 0 0
</DataArray>
<DataArray type="Int32" Name="boundary__north" format="ascii">
0 0 0 0 1 0 0
</DataArray>
<DataArray type="Int32" Name="boundary__bottom" format="ascii">
0 0 0 0 0 1 0
</DataArray>
<DataArray type="Int32" Name="boundary__top" format="ascii">
0 0 0 0 0 0 1
</DataArray>
</CellData>
<Points>
<DataArray type="Float64" Name="Points" NumberOfComponents="3" format="ascii">
0 0 0
10 0 0
10 10 0
0 10 0
0 0 10
10 0 10
10 10 10
0 10 10
</DataArray>
</Points>
<Cells>
<DataArray type="Int64" Name="connectivity" format="ascii">
0 1 2 3 4 5 6 7
0 3 7 4
1 2 6 5
0 1 5 4
3 2 6 7
0 1 2 3
4 5 6 7
</DataArray>
<DataArray type="Int64" Name="offsets" format="ascii">
8 12 16 20 24 28 32
</DataArray>
<DataArray type="UInt8" Name="types" format="ascii">
12 9 9 9 9 9 9
</DataArray>
</Cells>
</Piece>
</UnstructuredGrid>
</VTKFile>
