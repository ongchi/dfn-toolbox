<?xml version="1.0"?>
<!-- L shape in the x-y plane, 10 high in z. The bounding box is 10 x 10 x 10
     with its center at (15, 25, 35). No cell has x > 15 and y > 25.
     Cells 0 and 1: two hexahedra along x (the east arm, y 20 to 25).
     Cells 2 and 3: two wedges in +y (the north arm, x 10 to 15).
     Cell 4: the end face of the north arm (y = 30), boundary surface north.
     Cell 5: the end face of the east arm (x = 20), boundary surface east. -->
<VTKFile type="UnstructuredGrid" version="1.0" byte_order="LittleEndian">
<UnstructuredGrid>
<Piece NumberOfPoints="16" NumberOfCells="6">
<CellData Scalars="boundary__north">
<DataArray type="Int32" Name="boundary__north" format="ascii">
0 0 0 0 1 0
</DataArray>
<DataArray type="Int32" Name="boundary__east" format="ascii">
0 0 0 0 0 1
</DataArray>
</CellData>
<Points>
<DataArray type="Float64" Name="Points" NumberOfComponents="3" format="ascii">
10 20 30
15 20 30
20 20 30
10 25 30
15 25 30
20 25 30
10 30 30
15 30 30
10 20 40
15 20 40
20 20 40
10 25 40
15 25 40
20 25 40
10 30 40
15 30 40
</DataArray>
</Points>
<Cells>
<DataArray type="Int64" Name="connectivity" format="ascii">
0 1 4 3 8 9 12 11
1 2 5 4 9 10 13 12
3 4 7 11 12 15
3 7 6 11 15 14
6 7 15 14
2 5 13 10
</DataArray>
<DataArray type="Int64" Name="offsets" format="ascii">
8 16 22 28 32 36
</DataArray>
<DataArray type="UInt8" Name="types" format="ascii">
12 12 13 13 9 9
</DataArray>
</Cells>
</Piece>
</UnstructuredGrid>
</VTKFile>
