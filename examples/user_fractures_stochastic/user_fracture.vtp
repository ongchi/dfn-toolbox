<?xml version="1.0"?>
<!-- One large user-defined fracture in the cube of box_west_east: a
     rectangle in the plane y = 5, from x = 0.5 to 9.5 and z = 2 to 8. Its
     region is center: its mesh is cut at x = 1 (the boundary to west) and at
     x = 9 (the boundary to east). -->
<VTKFile type="PolyData" version="1.0" byte_order="LittleEndian">
<PolyData>
<Piece NumberOfPoints="4" NumberOfVerts="0" NumberOfLines="0" NumberOfStrips="0" NumberOfPolys="1">
<Points>
<DataArray type="Float64" Name="points" NumberOfComponents="3" format="ascii">
0.5 5.0 2.0
9.5 5.0 2.0
9.5 5.0 8.0
0.5 5.0 8.0
</DataArray>
</Points>
<Polys>
<DataArray type="Int64" Name="connectivity" format="ascii">
0 1 2 3
</DataArray>
<DataArray type="Int64" Name="offsets" format="ascii">
4
</DataArray>
</Polys>
<CellData>
<DataArray type="Int32" Name="region__center" format="ascii">
1
</DataArray>
</CellData>
</Piece>
</PolyData>
</VTKFile>
