<?xml version="1.0"?>
<!-- One large user-defined fracture in the cube of box_west_east: a
     rectangle in the plane y = 5, from x = -0.5 to 10.5 and z = 2 to 8. It
     has no region: it crosses the faces west (x = 0) and east (x = 10) of
     the cube, and its mesh is cut there. -->
<VTKFile type="PolyData" version="1.0" byte_order="LittleEndian">
<PolyData>
<Piece NumberOfPoints="4" NumberOfVerts="0" NumberOfLines="0" NumberOfStrips="0" NumberOfPolys="1">
<Points>
<DataArray type="Float64" Name="points" NumberOfComponents="3" format="ascii">
-0.5 5.0 2.0
10.5 5.0 2.0
10.5 5.0 8.0
-0.5 5.0 8.0
</DataArray>
</Points>
<Polys>
<DataArray type="Int64" Name="connectivity" format="ascii">
0 1 2 3
</DataArray>
<DataArray type="Int64" Name="offsets" format="ascii">
4
</DataArray>
</Polys>
</Piece>
</PolyData>
</VTKFile>
